{
  "name": "tricycall-rag",
  "version": "0.1.0",
  "description": "RAG pipeline for the Tricycall support assistant",
  "type": "module",
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx scripts/eval.ts",
    "db:migrate": "tsx scripts/migrate.ts",
